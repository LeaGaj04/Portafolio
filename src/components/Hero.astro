---
// 1. Importamos la herramienta mágica de Astro
import { Image } from "astro:assets";

// 2. NUEVA COMBINACIÓN DE FOTOS (1 Donellz, 2 Conception, 1 Beeway)
import imgDonellz from "../assets/images/Donellz/_DSC3188.jpeg";
import imgConception1 from "../assets/images/Conception/_DSC4633.jpeg";
import imgConception2 from "../assets/images/Conception/IMG_3227.jpeg"; 
import imgBeeway from "../assets/images/Beeway/_DSC4792.jpeg";
---

<section class="hero-section">
    <div class="container">
        <div class="carousel-wrapper">
            <button class="carousel-arrow prev">‹</button>

            <div class="carousel-track" id="track">
                <!-- 3. Usamos <Image /> con las fotos en el orden que pediste -->
                <Image
                    class="slide"
                    src={imgDonellz}
                    alt="Proyecto Donellz"
                    width={800}
                />
                <Image
                    class="slide"
                    src={imgConception1}
                    alt="Proyecto Conception 1"
                    width={800}
                />
                <Image
                    class="slide"
                    src={imgConception2}
                    alt="Proyecto Conception 2"
                    width={800}
                />
                <Image
                    class="slide"
                    src={imgBeeway}
                    alt="Proyecto Beeway"
                    width={800}
                />
            </div>

            <button class="carousel-arrow next">›</button>
        </div>
    </div>
</section>

<style>
    .hero-section {
        width: 100%;
        margin-top: 2rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
        height: 500px;
        max-height: 65vh;
        overflow: hidden;
    }

    .carousel-track {
        display: flex;
        gap: 10px;
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        scroll-behavior: smooth;
    }

    .slide {
        flex: 0 0 calc(20% - 8px);
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        color: var(--white);
        border: none;
        font-size: 3rem;
        cursor: pointer;
        z-index: 10;
        text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
        transition: transform 0.2s ease;
    }

    .carousel-arrow:hover {
        transform: translateY(-50%) scale(1.2);
    }

    .carousel-arrow.prev {
        left: 10px;
    }
    .carousel-arrow.next {
        right: 10px;
    }

    /* Adaptación a pantallas pequeñas */
    @media (max-width: 1024px) {
        .slide {
            flex: 0 0 calc(33.333% - 7px);
        }
    }

    @media (max-width: 768px) {
        .hero-section {
            margin-top: 1rem;
            margin-bottom: 3rem;
        }
        .carousel-wrapper {
            height: 60vh; /* Un poco más alto para que sea vertical */
            max-height: 450px;
        }
        .slide {
            flex: 0 0 85%; /* Muestra un poco de la siguiente para que se vea que es un carrusel */
            margin-right: 10px;
        }
        .carousel-arrow {
            font-size: 2rem;
        }
        .carousel-arrow.prev {
            left: 10px;
        }
        .carousel-arrow.next {
            right: 10px;
        }
    }
</style>

<script>
    const track = document.getElementById("track");
    const nextBtn = document.querySelector(".carousel-arrow.next");
    const prevBtn = document.querySelector(".carousel-arrow.prev");

    function slideNext() {
        if (!track) return;
        const slide = track.querySelector(".slide");
        if (!slide) return;

        const slideWidth = slide.clientWidth + 10;

        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
            track.scrollTo({ left: 0, behavior: "smooth" });
        } else {
            track.scrollBy({ left: slideWidth, behavior: "smooth" });
        }
    }

    function slidePrev() {
        if (!track) return;
        const slide = track.querySelector(".slide");
        if (!slide) return;

        const slideWidth = slide.clientWidth + 10;
        track.scrollBy({ left: -slideWidth, behavior: "smooth" });
    }

    let autoPlay = setInterval(slideNext, 3000);

    function resetAutoPlay() {
        clearInterval(autoPlay);
        autoPlay = setInterval(slideNext, 3000);
    }

    if (nextBtn && prevBtn && track) {
        nextBtn.addEventListener("click", () => {
            slideNext();
            resetAutoPlay();
        });

        prevBtn.addEventListener("click", () => {
            slidePrev();
            resetAutoPlay();
        });
    }
</script>