---
---

<section class="hero-carousel">
    <button class="carousel-arrow">‹</button>
    <div class="carousel-slide"></div>
    <button class="carousel-arrow">›</button>
</section>

<style>
    .hero-carousel {
        width: 100vw;
        height: 85vh;
        background-color: var(--black);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
    }
    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('https://images.unsplash.com/photo-1604928141064-207cea6f571f?q=80&w=2000&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        filter: grayscale(100%) contrast(1.2);
        z-index: 1;
    }
    .carousel-arrow {
        z-index: 2;
        background: none;
        border: none;
        color: var(--white);
        font-size: 3rem;
        padding: 0 3rem;
        cursor: pointer;
        mix-blend-mode: difference;
        transition: transform 0.3s ease;
    }
    .carousel-arrow:hover {
        transform: scale(1.2);
    }
</style>