<section class="hero-section">
    <div class="container">
        <div class="carousel-wrapper">
            <button class="carousel-arrow prev">‹</button>
            
            <div class="carousel-track" id="track">
                <!-- He puesto varias fotos variadas para que se note el efecto de corte -->
                <img class="slide" src="https://images.unsplash.com/photo-1604928141064-207cea6f571f?q=80&w=800&auto=format&fit=crop" alt="Slide 1">
                <img class="slide" src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=800&auto=format&fit=crop" alt="Slide 2">
                <img class="slide" src="https://images.unsplash.com/photo-1519638399535-1b036603ac77?q=80&w=800&auto=format&fit=crop" alt="Slide 3">
                <img class="slide" src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?q=80&w=800&auto=format&fit=crop" alt="Slide 4">
                <img class="slide" src="https://images.unsplash.com/photo-1512316635851-1e24747eb48b?q=80&w=800&auto=format&fit=crop" alt="Slide 5">
                <img class="slide" src="https://images.unsplash.com/photo-1554046920-90dc5823ca2f?q=80&w=800&auto=format&fit=crop" alt="Slide 6">
                <img class="slide" src="https://images.unsplash.com/photo-1524250502761-1ac6f2e30d43?q=80&w=800&auto=format&fit=crop" alt="Slide 7">
            </div>

            <button class="carousel-arrow next">›</button>
        </div>
    </div>
</section>

<style>
    .hero-section {
        width: 100%;
        margin-top: 2rem; 
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
        height: 500px; /* Altura fija para que parezcan tiras de fotos */
        max-height: 65vh;
        overflow: hidden; 
    }

    .carousel-track {
        display: flex;
        gap: 10px; /* La línea blanca delgada entre cada foto */
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        scroll-behavior: smooth;
    }

    .slide {
        /* MAGIA AQUÍ: 20% significa que entran exactamente 5 fotos completas */
        flex: 0 0 calc(20% - 8px); 
        height: 100%;
        /* El object-fit recorta cualquier foto (incluso horizontales) para que quepan en la tira vertical */
        object-fit: cover;
        object-position: center;
    }

    .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        color: var(--white);
        border: none;
        font-size: 3rem;
        cursor: pointer;
        z-index: 10;
        text-shadow: 0px 0px 10px rgba(0,0,0,0.5); 
        transition: transform 0.2s ease;
    }

    .carousel-arrow:hover {
        transform: translateY(-50%) scale(1.2);
    }

    .carousel-arrow.prev { left: 10px; }
    .carousel-arrow.next { right: 10px; }

    /* En pantallas más pequeñas, mostramos menos fotos a la vez */
    @media (max-width: 1024px) {
        .slide { flex: 0 0 calc(33.333% - 7px); } /* 3 fotos en tablet */
    }
    @media (max-width: 768px) {
        .slide { flex: 0 0 calc(50% - 5px); } /* 2 fotos en celular */
    }
</style>

<script>
    const track = document.getElementById('track');
    const nextBtn = document.querySelector('.carousel-arrow.next');
    const prevBtn = document.querySelector('.carousel-arrow.prev');

    function slideNext() {
        if (!track) return;
        const slide = track.querySelector('.slide');
        if (!slide) return;
        
        const slideWidth = slide.clientWidth + 10; // ancho de foto + el gap de 10px

        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
            track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
            track.scrollBy({ left: slideWidth, behavior: 'smooth' });
        }
    }

    function slidePrev() {
        if (!track) return;
        const slide = track.querySelector('.slide');
        if (!slide) return;
        
        const slideWidth = slide.clientWidth + 10;
        track.scrollBy({ left: -slideWidth, behavior: 'smooth' });
    }

    let autoPlay = setInterval(slideNext, 3000);

    function resetAutoPlay() {
        clearInterval(autoPlay);
        autoPlay = setInterval(slideNext, 3000);
    }

    if (nextBtn && prevBtn && track) {
        nextBtn.addEventListener('click', () => {
            slideNext();
            resetAutoPlay();
        });

        prevBtn.addEventListener('click', () => {
            slidePrev();
            resetAutoPlay();
        });
    }
</script>