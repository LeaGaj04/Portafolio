<section class="hero-section">
    <div class="container">
        <div class="carousel-wrapper">
            <button class="carousel-arrow prev">‹</button>

            <div class="carousel-track" id="track">
                <img
                    class="slide"
                    src="/images/Conception/_DSC4284.jpeg"
                    alt="Proyecto Conception 1"
                />
                <img
                    class="slide"
                    src="/images/Conception/_DSC4296.jpeg"
                    alt="Proyecto Conception 2"
                />
                <img
                    class="slide"
                    src="/images/Conception/_DSC4327.jpeg"
                    alt="Proyecto Conception 3"
                />
                <img
                    class="slide"
                    src="/images/Conception/_DSC4633.jpeg"
                    alt="Proyecto Conception 4"
                />
                <img
                    class="slide"
                    src="/images/Conception/_DSC4641.jpeg"
                    alt="Proyecto Conception 5"
                />
                <img
                    class="slide"
                    src="/images/Conception/_DSC4655.jpeg"
                    alt="Proyecto Conception 6"
                />
                <img
                    class="slide"
                    src="/images/Conception/IMG_3216.jpeg"
                    alt="Proyecto Conception 7"
                />
            </div>

            <button class="carousel-arrow next">›</button>
        </div>
    </div>
</section>

<style>
    .hero-section {
        width: 100%;
        margin-top: 2rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
        height: 500px; /* Altura fija para que parezcan tiras de fotos */
        max-height: 65vh;
        overflow: hidden;
    }

    .carousel-track {
        display: flex;
        gap: 10px; /* La línea blanca delgada entre cada foto */
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        scroll-behavior: smooth;
    }

    .slide {
        /* MAGIA AQUÍ: 20% significa que entran exactamente 5 fotos completas */
        flex: 0 0 calc(20% - 8px);
        height: 100%;
        /* El object-fit recorta cualquier foto (incluso horizontales) para que quepan en la tira vertical */
        object-fit: cover;
        object-position: center;
    }

    .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        color: var(--white);
        border: none;
        font-size: 3rem;
        cursor: pointer;
        z-index: 10;
        text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
        transition: transform 0.2s ease;
    }

    .carousel-arrow:hover {
        transform: translateY(-50%) scale(1.2);
    }

    .carousel-arrow.prev {
        left: 10px;
    }
    .carousel-arrow.next {
        right: 10px;
    }

    /* En pantallas más pequeñas, mostramos menos fotos a la vez */
    @media (max-width: 1024px) {
        .slide {
            flex: 0 0 calc(33.333% - 7px);
        } /* 3 fotos en tablet */
    }
    @media (max-width: 768px) {
        .slide {
            flex: 0 0 calc(50% - 5px);
        } /* 2 fotos en celular */
    }
</style>

<script>
    const track = document.getElementById("track");
    const nextBtn = document.querySelector(".carousel-arrow.next");
    const prevBtn = document.querySelector(".carousel-arrow.prev");

    function slideNext() {
        if (!track) return;
        const slide = track.querySelector(".slide");
        if (!slide) return;

        const slideWidth = slide.clientWidth + 10; // ancho de foto + el gap de 10px

        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
            track.scrollTo({ left: 0, behavior: "smooth" });
        } else {
            track.scrollBy({ left: slideWidth, behavior: "smooth" });
        }
    }

    function slidePrev() {
        if (!track) return;
        const slide = track.querySelector(".slide");
        if (!slide) return;

        const slideWidth = slide.clientWidth + 10;
        track.scrollBy({ left: -slideWidth, behavior: "smooth" });
    }

    let autoPlay = setInterval(slideNext, 3000);

    function resetAutoPlay() {
        clearInterval(autoPlay);
        autoPlay = setInterval(slideNext, 3000);
    }

    if (nextBtn && prevBtn && track) {
        nextBtn.addEventListener("click", () => {
            slideNext();
            resetAutoPlay();
        });

        prevBtn.addEventListener("click", () => {
            slidePrev();
            resetAutoPlay();
        });
    }
</script>
