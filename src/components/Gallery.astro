---
import { Image } from 'astro:assets';

import imgBasketball from '../assets/images/Basketball/IMG_3097.jpeg';
import imgBeeway from '../assets/images/Beeway/_DSC4770.jpeg';
import imgConception from '../assets/images/Conception/_DSC4284.jpeg';
import imgDonellz from '../assets/images/Donellz/_DSC3125.jpeg';
import imgRedbull from '../assets/images/Redbull/IMG_1068.jpeg';
import imgUrbano from '../assets/images/Urbano/_DSC3285.jpeg';
---

<section id="fotografo" class="portfolio-grid">
    <div class="grid-item">
        <a href="/trabajos/basketball">
            <Image src={imgBasketball} alt="Proyecto Basketball" width={800} />
            <div class="hover-overlay">VER PROYECTO</div>
        </a>
    </div>
    
    <div class="grid-item">
        <a href="/trabajos/beeway">
            <Image src={imgBeeway} alt="Proyecto Beeway" width={800} />
            <div class="hover-overlay">VER PROYECTO</div>
        </a>
    </div>
    
    <div class="grid-item">
        <a href="/trabajos/conception">
            <Image src={imgConception} alt="Proyecto Conception" width={800} />
            <div class="hover-overlay">VER PROYECTO</div>
        </a>
    </div>
    
    <div class="grid-item">
        <a href="/trabajos/donellz">
            <Image src={imgDonellz} alt="Proyecto Donellz" width={800} />
            <div class="hover-overlay">VER PROYECTO</div>
        </a>
    </div>
    
    <div class="grid-item">
        <a href="/trabajos/redbull">
            <Image src={imgRedbull} alt="Proyecto Redbull" width={800} />
            <div class="hover-overlay">VER PROYECTO</div>
        </a>
    </div>
    
    <div class="grid-item">
        <a href="/trabajos/urbano">
            <Image src={imgUrbano} alt="Proyecto Urbano" width={800} />
            <div class="hover-overlay">VER PROYECTO</div>
        </a>
    </div>
</section>

<style>
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        width: 100%;
    }

    .grid-item {
        width: 100%;
        aspect-ratio: 3 / 4;
        background-color: #111;
        overflow: hidden;
        position: relative;
    }

    .grid-item a {
        display: block;
        width: 100%;
        height: 100%;
    }

    .grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    /* Panel oscuro que aparece al hacer hover */
    .hover-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.2rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .grid-item:hover img {
        transform: scale(1.05);
    }

    .grid-item:hover .hover-overlay {
        opacity: 1;
    }

    @media (max-width: 1024px) {
        .portfolio-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    
    @media (max-width: 768px) {
        .portfolio-grid {
            grid-template-columns: 1fr;
        }
        .grid-item {
            aspect-ratio: 4 / 5;
        }
    }
</style>