<section id="fotografo" class="portfolio-grid">
    <!-- Seleccionamos la primera imagen de cada una de tus carpetas reales -->
    <div class="grid-item">
        <img src="/images/Basketball/IMG_3097.jpeg" alt="Proyecto Basketball">
    </div>
    
    <div class="grid-item">
        <img src="/images/Beeway/_DSC4770.jpeg" alt="Proyecto Beeway">
    </div>
    
    <div class="grid-item">
        <img src="/images/Conception/_DSC4284.jpeg" alt="Proyecto Conception">
    </div>
    
    <div class="grid-item">
        <img src="/images/Donellz/_DSC3125.jpeg" alt="Proyecto Donellz">
    </div>
    
    <div class="grid-item">
        <img src="/images/Redbull/IMG_1068.jpeg" alt="Proyecto Redbull">
    </div>
    
    <div class="grid-item">
        <img src="/images/Urbano/_DSC3285.jpeg" alt="Proyecto Urbano">
    </div>
</section>

<style>
    .portfolio-grid {
        display: grid;
        /* Cambiamos a 3 columnas para que las 6 fotos encajen en 2 filas exactas */
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        width: 100%;
    }

    .grid-item {
        width: 100%;
        aspect-ratio: 3 / 4; /* Mantiene el formato de retrato alto */
        background-color: #111;
        overflow: hidden;
        position: relative;
    }

    .grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Efecto blanco y negro por defecto */
        filter: grayscale(100%);
        transition: filter 0.5s ease, transform 0.5s ease;
    }

    /* EFECTO HOVER: Vuelve al color original y hace un zoom suave */
    .grid-item:hover img {
        transform: scale(1.05);
        filter: grayscale(0%); 
    }

    /* --- Adaptación Responsive --- */
    
    /* En tablets, mostramos 2 columnas (3 filas de 2 fotos) */
    @media (max-width: 1024px) {
        .portfolio-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    
    /* En celulares, mostramos 1 sola columna (1 foto debajo de la otra) */
    @media (max-width: 768px) {
        .portfolio-grid {
            grid-template-columns: 1fr;
        }
        /* Hacemos que las fotos no sean tan inmensamente altas en celulares */
        .grid-item {
            aspect-ratio: 4 / 5;
        }
    }
</style>