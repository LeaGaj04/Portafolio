---
// 1. Importamos el componente mágico de Astro
import { Image } from 'astro:assets';

// 2. Importamos tus fotos locales desde la nueva carpeta assets
import imgBasketball from '../assets/images/Basketball/IMG_3097.jpeg';
import imgBeeway from '../assets/images/Beeway/_DSC4770.jpeg';
import imgConception from '../assets/images/Conception/_DSC4284.jpeg';
import imgDonellz from '../assets/images/Donellz/_DSC3125.jpeg';
import imgRedbull from '../assets/images/Redbull/IMG_1068.jpeg';
import imgUrbano from '../assets/images/Urbano/_DSC3285.jpeg';
---

<section id="fotografo" class="portfolio-grid">
    <!-- 3. Usamos <Image /> en lugar de <img> y le damos un ancho máximo -->
    <div class="grid-item">
        <Image src={imgBasketball} alt="Proyecto Basketball" width={800} />
    </div>
    
    <div class="grid-item">
        <Image src={imgBeeway} alt="Proyecto Beeway" width={800} />
    </div>
    
    <div class="grid-item">
        <Image src={imgConception} alt="Proyecto Conception" width={800} />
    </div>
    
    <div class="grid-item">
        <Image src={imgDonellz} alt="Proyecto Donellz" width={800} />
    </div>
    
    <div class="grid-item">
        <Image src={imgRedbull} alt="Proyecto Redbull" width={800} />
    </div>
    
    <div class="grid-item">
        <Image src={imgUrbano} alt="Proyecto Urbano" width={800} />
    </div>
</section>

<style>
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        width: 100%;
    }

    .grid-item {
        width: 100%;
        aspect-ratio: 3 / 4;
        background-color: #111;
        overflow: hidden;
        position: relative;
    }

    /* La etiqueta <Image /> genera un <img> en el HTML final, así que este CSS sigue funcionando perfecto */
    .grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
        transition: filter 0.5s ease, transform 0.5s ease;
    }

    .grid-item:hover img {
        transform: scale(1.05);
        filter: grayscale(0%); 
    }

    @media (max-width: 1024px) {
        .portfolio-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    
    @media (max-width: 768px) {
        .portfolio-grid {
            grid-template-columns: 1fr;
        }
        .grid-item {
            aspect-ratio: 4 / 5;
        }
    }
</style>