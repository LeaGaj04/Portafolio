<section class="about-section">
    <div class="about-text">
        <h2>Cineasta,<br>Creador,<br>Director de Fotografía.</h2>
        <p>Especializado en narrativas visuales de alto impacto — del cortometraje al editorial de moda. Cada encuadre es una elección deliberada. Cada proyecto, una conversación entre luz, tiempo y silencio.</p>
    </div>
    <div class="about-image"></div>
</section>

<style>
    .about-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem; /* Espacio entre texto y foto reducido */
        padding: 5rem 6rem; /* Padding superior e inferior reducido drásticamente */
        align-items: center;
        max-width: 1400px;
        margin: 0 auto; /* Centra la sección en pantallas enormes */
    }

    .about-text h2 {
        font-size: 2.8rem; /* Titular un poco más pequeño */
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }

    .about-text p {
        font-size: 1rem;
        line-height: 1.6;
        font-weight: 300;
        max-width: 90%;
    }

    .about-image {
        width: 100%;
        max-height: 65vh; /* Límite de altura: 65% de la pantalla */
        aspect-ratio: 3 / 4; /* Mantiene la proporción de retrato */
        background-color: var(--gray-placeholder);
        /* Aquí debes colocar la URL de la foto de Christopher Moreno */
        background-image: url('https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=800&auto=format&fit=crop');
        background-size: cover;
        background-position: center top; /* Asegura que la cara (parte superior) no se corte */
        filter: grayscale(100%);
    }

    @media (max-width: 1024px) {
        .about-section {
            grid-template-columns: 1fr;
            padding: 4rem 2rem;
            gap: 2rem;
        }
        
        .about-image {
            max-height: 50vh; /* En móviles la imagen es aún más compacta */
        }
    }
</style>