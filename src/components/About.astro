<section class="about-wrapper">
    <div class="container about-content">
        <div class="about-text">
            <h2>Cineasta,<br />Creador,<br />Director de Fotografía.</h2>
            <p>
                Especializado en narrativas visuales de alto impacto — del
                cortometraje al editorial de moda. Cada encuadre es una elección
                deliberada. Cada proyecto, una conversación entre luz, tiempo y
                silencio.
            </p>
        </div>
        <div class="about-image"></div>
    </div>
</section>

<style>
    .about-wrapper {
        width: 100%;
        background-color: #f7f7f7;
        margin: 5rem 0; /* Margen blanco superior e inferior */
        padding: 3.5rem 0; /* REDUCIDO: Menos altura para el fondo gris */
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .about-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem; /* REDUCIDO: Menos espacio entre texto y foto */
        align-items: center;
    }

    .about-text h2 {
        font-size: 2.4rem; /* REDUCIDO: Titular más compacto */
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1.2rem;
        text-transform: uppercase;
    }

    .about-text p {
        font-size: 0.95rem;
        line-height: 1.6;
        font-weight: 300;
        max-width: 90%;
    }

    .about-image {
        width: 100%;
        max-height: 50vh; /* REDUCIDO: La foto ocupará máximo la mitad de la pantalla */
        aspect-ratio: 3 / 4;
        background-color: var(--gray-placeholder);
        /* Ruta de tu foto */
        background-image: url("https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=800&auto=format&fit=crop");
        background-size: cover;
        background-position: center top;
        filter: grayscale(100%);
    }

    /* Adaptación a móviles */
    @media (max-width: 1024px) {
        .about-wrapper {
            margin: 2rem 0; /* Menos margen exterior */
            padding: 3rem 1rem; /* Añadimos padding lateral (1rem) para que el texto no toque los bordes */
        }

        .about-content {
            grid-template-columns: 1fr;
            gap: 2.5rem; /* Aseguramos espacio entre el texto y la foto */
        }

        .about-text h2 {
            font-size: 2rem; /* Titular más pequeño en móvil */
        }

        .about-image {
            max-height: 45vh;
            margin-bottom: 1rem; /* Un poco de aire abajo de la foto */
        }
    }
</style>
