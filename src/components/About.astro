<section class="about-section">
    <div class="about-text">
        <h2>Cineasta,<br>Creador,<br>Director de Fotografía.</h2>
        <p>Especializado en narrativas visuales de alto impacto — del cortometraje al editorial de moda. Cada encuadre es una elección deliberada. Cada proyecto, una conversación entre luz, tiempo y silencio.</p>
    </div>
    <div class="about-image"></div>
</section>

<style>
    .about-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        padding: 12rem 8rem;
        align-items: center;
    }
    .about-text h2 {
        font-size: 3.5rem;
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 2rem;
        text-transform: uppercase;
    }
    .about-text p {
        font-size: 1.1rem;
        line-height: 1.6;
        font-weight: 300;
        max-width: 85%;
    }
    .about-image {
        width: 100%;
        aspect-ratio: 3 / 4;
        background-color: var(--gray-placeholder);
        background-image: url('https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=800&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        filter: grayscale(100%);
    }

    @media (max-width: 1024px) {
        .about-section {
            grid-template-columns: 1fr;
            padding: 8rem 4rem;
        }
    }
</style>