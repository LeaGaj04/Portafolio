                    <img
                        class="avatar"
                        src="/images/Redes/insta.jpg"
                        alt="Avatar de Instagram"
                    />
                    <div class="profile-info">
                        <div class="profile-name">
                            <a
                                href="https://www.tiktok.com/@by.dezeta"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="profile-link"
                            >
                                <h4>Dezeta</h4>
                                <span class="muted-handle">@by.dezeta</span>
                            </a>
                        </div>
                        <div class="stats">
                            <!-- Edita tus números reales aquí -->
                            <span><strong>278</strong> Siguiendo</span>
                            <span><strong>11.1K</strong> Seguidores</span>
                            <span><strong>538.1K</strong> Me gusta</span>
                        </div>
                        <!-- Botón convertido en enlace -->
                        <a
                            href="https://www.tiktok.com/@by.dezeta"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="follow-btn">Seguir en TikTok</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .creator-section {
        width: 100%;
        margin: 6rem 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    /* --- HEADER --- */
    .creator-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4rem;
    }

    .creator-header h2 {
        font-size: 2.5rem;
        font-weight: 900;
        letter-spacing: 0.1em;
    }

    .handle-info {
        text-align: center;
        display: flex;
        flex-direction: column;
    }

    .username-link {
        text-decoration: none;
        color: var(--black);
        transition: opacity 0.3s ease;
    }
    .username-link:hover {
        opacity: 0.7;
    }

    .handle-info .username {
        font-weight: 900;
        font-size: 1.1rem;
    }

    .handle-info .bio-desc {
        font-size: 0.8rem;
        color: #666;
    }

    .social-icons-large {
        display: flex;
        gap: 1.5rem;
    }

    .social-icons-large a {
        transition: transform 0.2s ease;
        display: flex;
    }

    .social-icons-large a:hover {
        transform: scale(1.1);
    }

    .social-icons-large svg {
        width: 24px;
        fill: var(--black);
    }

    /* --- PERFILES --- */
    .profiles-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
    }

    .social-column h3 {
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: 0.05em;
    }

    .profile-card {
        display: flex;
        gap: 2rem;
        align-items: flex-start;
    }

    .avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        filter: grayscale(100%);
    }

    .profile-info {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .profile-link {
        text-decoration: none;
        color: var(--black);
        display: flex;
        flex-direction: column;
    }

    .profile-link:hover h4 {
        text-decoration: underline;
    }

    .profile-name h4 {
        font-size: 1.2rem;
        font-weight: 900;
        margin: 0;
    }

    .muted-handle {
        font-size: 0.8rem;
        color: #888;
    }

    .stats {
        display: flex;
        gap: 1.5rem;
        font-size: 0.9rem;
    }

    .bio-text {
        font-size: 0.85rem;
        line-height: 1.4;
        color: #333;
    }

    /* El botón ahora es un enlace 'a' disfrazado de botón */
    .follow-btn {
        background-color: var(--black);
        color: var(--white);
        text-decoration: none;
        padding: 0.5rem 2rem;
        font-weight: 700;
        border-radius: 4px;
        text-align: center;
        width: fit-content;
        transition: opacity 0.2s;
    }

    .follow-btn:hover {
        opacity: 0.8;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .creator-header {
            flex-direction: column;
            gap: 2rem;
            text-align: center;
        }
        .profiles-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
    }

    @media (max-width: 768px) {
        .creator-section {
            margin: 3rem 0;
        }

        .creator-header {
            margin-bottom: 2.5rem;
        }

        .profiles-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.5rem;
        }

        .stats {
            justify-content: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .follow-btn {
            margin: 0 auto;
        }
    }
</style>
