---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Christopher Moreno | Films">
    <section style="padding: 4rem 2rem; max-width: 1000px; margin: 0 auto;">
        <h1 style="margin-bottom: 3rem;">FILMS</h1>
        
        <!-- Repite este bloque para cada video -->
        <div class="film-item" style="margin-bottom: 4rem;">
            <div style="aspect-ratio: 16/9; background: #eee; margin-bottom: 1rem;"></div>
            <h2 style="font-size: 1.5rem;">Título del Film</h2>
            <p style="color: #666;">Colaboración: Nombre del artista/cliente</p>
        </div>
        
        <a href="/" style="color: black;">← Volver al inicio</a>
    </section>
</Layout>